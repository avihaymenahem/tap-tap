<!-- The splash brand mark: two neon "tap tiles" (the game's own note tiles) over
     a soft pink glow, on the app's navy splash background. A plain vector — not
     the adaptive launcher icon — because the Android 12+ splash mis-renders
     adaptive icons on some OEMs (Samsung/One UI), which is why the splash looked
     broken. Art stays in the centre safe zone so the splash's circular mask
     never crops it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Neon glow halo behind the tiles. -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="50">
                <item android:offset="0" android:color="#59FF3FA4" />
                <item android:offset="0.6" android:color="#1FFF3FA4" />
                <item android:offset="1" android:color="#00FF3FA4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tile A (lower-left, tilted). -->
    <group android:pivotX="42" android:pivotY="57" android:rotation="-10">
        <path android:pathData="M34,43 L50,43 A6,6 0 0 1 56,49 L56,65 A6,6 0 0 1 50,71 L34,71 A6,6 0 0 1 28,65 L28,49 A6,6 0 0 1 34,43 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="28"
                    android:startY="43"
                    android:endX="56"
                    android:endY="71">
                    <item android:offset="0" android:color="#FF9BE8FF" />
                    <item android:offset="0.35" android:color="#FF35E0FF" />
                    <item android:offset="0.75" android:color="#FF7A4FFF" />
                    <item android:offset="1" android:color="#FF4A2BA0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Tile B (upper-right, tilted the other way). -->
    <group android:pivotX="66" android:pivotY="51" android:rotation="10">
        <path android:pathData="M58,37 L74,37 A6,6 0 0 1 80,43 L80,59 A6,6 0 0 1 74,65 L58,65 A6,6 0 0 1 52,59 L52,43 A6,6 0 0 1 58,37 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="52"
                    android:startY="37"
                    android:endX="80"
                    android:endY="65">
                    <item android:offset="0" android:color="#FF9BE8FF" />
                    <item android:offset="0.35" android:color="#FF35E0FF" />
                    <item android:offset="0.75" android:color="#FF7A4FFF" />
                    <item android:offset="1" android:color="#FF4A2BA0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
